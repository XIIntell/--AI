# Disable pnpm's minimum-release-age supply-chain policy for this project.
#
# pnpm 10+ rejects packages published "too recently" by default (typically <24h),
# which blocks fresh lockfiles right after generation. The dependencies in
# this repo are all from well-known authors (TypeScript, ESLint, discord.js,
# Google) — the protection is more annoying than useful here.
#
# Remove this line if you want pnpm's default supply-chain protection back.
minimum-release-age=0
