# Discord bot token (from https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=

# Discord application client ID (optional; auto-detected from the token if omitted)
# Find on https://discord.com/developers/applications -> your app -> "General Information" -> "Application ID"
DISCORD_CLIENT_ID=

# Optional: ID твоего тестового сервера (Server Settings -> Widget -> Server ID,
# или включи Developer Mode в Discord и правый клик по серверу -> Copy Server ID).
# Если указано, slash-команды появятся МГНОВЕННО на этом сервере (вместо ждать до часа).
DISCORD_TEST_GUILD_ID=

# Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model name (default: gemini-2.5-flash; free tier friendly)
# Alternatives: gemini-2.5-flash-lite (быстрее, дешевле), gemini-2.5-pro (платный, умнее)
GEMINI_MODEL=gemini-2.5-flash

# Path to SQLite database file (for conversation memory)
DATABASE_PATH=./data/bot.db

# Logging level (debug | info | warn | error)
LOG_LEVEL=info

# How many recent messages to remember per channel for context
MEMORY_CONTEXT_SIZE=10
